{
  "name": "@flatkeeper/ui",
  "version": "0.4.0",
  "description": "flatkeeper design system: tokens and shared components of the host cabinet, the guest mini-site and the staff admin panel",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "files": [
    "tokens.css",
    "admin.css",
    "host-color.js",
    "host-color.d.ts",
    "calendar",
    "art"
  ],
  "exports": {
    "./tokens.css": "./tokens.css",
    "./admin.css": "./admin.css",
    "./host-color": {
      "types": "./host-color.d.ts",
      "default": "./host-color.js"
    },
    "./calendar": {
      "types": "./calendar/calendar.d.ts",
      "default": "./calendar/calendar.js"
    },
    "./CalendarMonth.svelte": {
      "types": "./calendar/CalendarMonth.svelte",
      "svelte": "./calendar/CalendarMonth.svelte"
    },
    "./EmptyArt.svelte": {
      "types": "./art/EmptyArt.svelte",
      "svelte": "./art/EmptyArt.svelte"
    },
    "./NotFoundArt.svelte": {
      "types": "./art/NotFoundArt.svelte",
      "svelte": "./art/NotFoundArt.svelte"
    }
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.2.7",
    "@fontsource-variable/jetbrains-mono": "^5.3.0"
  },
  "peerDependencies": {
    "svelte": "^5.57.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  }
}
